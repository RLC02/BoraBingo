# Imagem JVM ultraleve para Microservicos Spring Boot
# Usa o JAR pre-compilado pelo Maven
FROM eclipse-temurin:17-jre
ARG SERVICE
WORKDIR /app

COPY ${SERVICE}/target/${SERVICE}-1.0.0.jar app.jar

# SerialGC, heap e metaspace pequenos, stack reduzida e JIT C1 para consumo minimo no Render
ENV JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -Xms32m -Xmx128m -XX:MaxMetaspaceSize=96m -Xss256k -XX:ReservedCodeCacheSize=32m -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError"

ENTRYPOINT ["java", "-jar", "app.jar"]
